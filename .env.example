# Copy to .env (gitignored) and fill in. Dev environment ONLY — never point
# this harness at production or at another player's account (see CLAUDE.md,
# "Rules of engagement").

# Base URL of the DFMC / Herumon Tower DEV environment.
DFMC_BASE_URL=https://dev.playdfmc.com

# Where the interactive login saves its session, and where the observer reads
# it from. Relative paths resolve against the repo root. Gitignored.
DFMC_STORAGE_STATE=storage_state.json
